      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst reply =\n  input.text ||\n  input.output ||\n  input.response ||\n  \"\";\n\nif (!reply) {\n  throw new Error(\"Previous AI node did not return a reply.\");\n}\n\nreturn [\n  {\n    json: {\n      reply: String(reply).trim()\n    }\n  }\n];"
